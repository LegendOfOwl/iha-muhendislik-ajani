void SetI( const string &in analysis, const string &in key, int value )
{
    array<int> data(1); data[0] = value;
    SetIntAnalysisInput( analysis, key, data );
}
void SetD( const string &in analysis, const string &in key, double value )
{
    array<double> data(1); data[0] = value;
    SetDoubleAnalysisInput( analysis, key, data );
}
string MakeWing( const string &in name, double halfspan, double root, double tip,
                 double x, double z, bool vertical, int nu, int nw )
{
    string id = AddGeom( "WING", "" );
    SetGeomName( id, name );
    SetDriverGroup( id, 1, SPAN_WSECT_DRIVER, ROOTC_WSECT_DRIVER, TIPC_WSECT_DRIVER );
    SetParmVal( id, "Span", "XSec_1", halfspan );
    SetParmVal( id, "Root_Chord", "XSec_1", root );
    SetParmVal( id, "Tip_Chord", "XSec_1", tip );
    SetParmVal( id, "Sweep", "XSec_1", 0.0 );
    SetParmVal( id, "Dihedral", "XSec_1", 0.0 );
    SetParmVal( id, "Twist", "XSec_1", 0.0 );
    SetParmVal( id, "X_Rel_Location", "XForm", x );
    SetParmVal( id, "Z_Rel_Location", "XForm", z );
    if ( vertical )
    {
        SetParmVal( id, "Sym_Planar_Flag", "Sym", 0 );
        SetParmVal( id, "X_Rel_Rotation", "XForm", 90.0 );
    }
    SetParmVal( id, "Tess_W", "Shape", nw );
    SetParmVal( id, "SectTess_U", "XSec_1", nu );
    string surf = GetXSecSurf( id, 0 );
    for ( int n = 0; n < GetNumXSec( surf ); n++ )
    {
        string xs = GetXSec( surf, n );
        SetParmVal( GetXSecParm( xs, "Camber" ), 0.0 );
        SetParmVal( GetXSecParm( xs, "ThickChord" ), 0.12 );
    }
    SetSetFlag( id, 3, true );
    Update();
    return id;
}
int main()
{
    ClearVSPModel();
    Print( GetVSPVersion() );
    string wing=MakeWing("Study_AR8",1,0.25,0.25,0,0,false,17,49);
    Update();
    string vehicle = FindContainer( "Vehicle", 0 );
    SetParmVal( FindParm( vehicle, "LenUnit", "STEPSettings" ), LEN_M );
    WriteVSPFile( "model.vsp3", SET_ALL );
    string geom = "VSPAEROComputeGeometry";
    SetAnalysisInputDefaults( geom );
    SetI( geom, "GeomSet", SET_NONE );
    SetI( geom, "ThinGeomSet", 3 );
    // Tested single mesh. NRef=1 generated a multi-mesh file not solved in our first run.
    SetI( geom, "NRef", 0 );
    string geometry_results = ExecAnalysis( geom );
    PrintResults( geometry_results );
    string analysis = "VSPAEROSweep";
    SetAnalysisInputDefaults( analysis );
    SetI( analysis, "GeomSet", SET_NONE );
    SetI( analysis, "ThinGeomSet", 3 );
    SetI( analysis, "NCPU", 2 );
    SetI( analysis, "RefFlag", 0 );
    SetD( analysis, "Sref", 0.5 );
    SetD( analysis, "bref", 2 );
    SetD( analysis, "cref", 0.25 );
    SetD( analysis, "Xcg", 0.0625 );
    SetD( analysis, "Vinf", 30 );
    SetD( analysis, "Rho", 1.225 );
    SetD( analysis, "MachStart", 0.0881590624578 );
    SetD( analysis, "MachEnd", 0.0881590624578 );
    SetI( analysis, "MachNpts", 1 );
    SetD( analysis, "ReCref", 513440.259305 );
    SetD( analysis, "ReCrefEnd", 513440.259305 );
    SetI( analysis, "ReCrefNpts", 1 );
    SetD( analysis, "AlphaStart", 4 );
    SetD( analysis, "AlphaEnd", 4 );
    SetI( analysis, "AlphaNpts", 1 );
    SetI( analysis, "StallModel", 0 );
    SetI( analysis, "WakeNumIter", 40 );
    string results = ExecAnalysis( analysis );
    WriteResultsCSVFile( results, "results.csv" );
    // Exports follow the solver. Do not feed a visualization mesh back into the analysis set.
    
    int errors = GetNumTotalErrors();
    while ( GetNumTotalErrors() > 0 )
    {
        ErrorObj err = PopLastError();
        Print( err.GetErrorString() );
    }
    if ( errors == 0 ) Print( "NATIVE_ANALYSIS_COMPLETE" );
    return errors;
}
